{
  "name": "vitality",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "build:tiles": "node scripts/build-tile.mjs",
    "prebuild": "npm run build:tiles",
    "mutate": "node scripts/mutate.mjs",
    "mutate:lint": "node scripts/mutate.mjs --mode=lint",
    "mutate:callsites": "node scripts/mutate.mjs --mode=callsites",
    "mutate:fuzz": "node scripts/mutate.mjs --mode=fuzz",
    "verify": "npm run build:tiles && tsc --noEmit && vitest run tests/ && node scripts/mutate.mjs --mode=lint && node scripts/style-lint.mjs",
    "verify:fast": "npm run build:tiles && tsc --noEmit && node scripts/mutate.mjs --mode=lint && node scripts/style-lint.mjs",
    "verify:push": "vitest run tests/",
    "verify:full": "npm run build:tiles && tsc --noEmit && node scripts/mutate.mjs --mode=lint && node scripts/style-lint.mjs && node scripts/mutate.mjs --mode=callsites --require-pinned && node scripts/mutate.mjs --mode=fuzz --require-pinned && vitest run tests/ && node scripts/mutate.mjs --mode=mutate --require-pinned",
    "prepare": "git config core.hooksPath .githooks || true",
    "build:contact": "node scripts/build-contact-sheet.mjs",
    "style:lint": "node scripts/style-lint.mjs",
    "measure:targets": "node scripts/measure-targets.mjs",
    "build:markup": "node scripts/build-markup-reference.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "@supabase/supabase-js": "^2.105.4",
    "mcp-handler": "^1.1.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "three": "^0.184.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.184.1",
    "esbuild": "^0.24.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^30.1.0",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "acorn": "^8.17.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.63.3"
  }
}
