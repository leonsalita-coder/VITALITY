#!/bin/sh
#
# The gate, so it cannot be bypassed by forgetting.
#
# It was bypassed twice by forgetting: `npm run verify` was run as its own
# command, came back red, and the commit went ahead anyway because nothing
# connected the two. Chaining them is discipline, and discipline is the
# thing that fails at 2am — the same class as every other bug this engine
# has produced.
#
# Escape hatch: `git commit --no-verify`. It exists because a hook with no
# way out gets deleted the first time somebody needs to commit a
# work-in-progress on a branch. Using it on main is the thing to avoid,
# not the flag itself.

set -e

# A mutation run is in progress, which means the working tree currently
# holds deliberately broken code.
#
# This is not hypothetical. During a call-site sweep something ran
# `git add` while the tile was stubbed, and the staged copy of
# public/tiles/train.html contained `((()=>undefined))(changeContext())`.
# The harness restores the WORKING TREE when it finishes; it has no way to
# un-stage what another process staged in the meantime, and an automatic
# committer would have shipped a tile with a dead engine call in it.
#
# .mutate-snapshot.json exists for exactly the duration of a run, so its
# presence is the signal. Checked before SKIP_VERIFY on purpose: this is
# not a quality gate somebody might reasonably want to skip, it is a
# "the files on disk are not what you think" gate.
if [ -f .mutate-snapshot.json ]; then
  echo ""
  echo " COMMIT BLOCKED — a mutation run is in progress."
  echo ""
  echo " The working tree currently contains deliberately broken code."
  echo " Wait for it to finish, or run 'node scripts/mutate.mjs --mode=lint'"
  echo " to restore the files it left behind, then commit."
  exit 1
fi

if [ -n "$SKIP_VERIFY" ]; then
  echo "pre-commit: SKIP_VERIFY set, gate skipped"
  exit 0
fi

echo "pre-commit: build, typecheck, mutation lint, style lint…"

# The full test suite (~4 min) runs at pre-push instead, not here. This
# gate stays structural and fast (~2s): tiles rebuilt and in sync,
# typecheck clean, no new absence assertions without a positive control,
# no raw hex/px outside the token block. `npm run verify` still runs
# everything, including the suite, by hand.
if ! npm run --silent verify:fast; then
  echo ""
  echo "──────────────────────────────────────────────────────────────"
  echo " COMMIT BLOCKED — verify:fast failed."
  echo ""
  echo " One of: the tiles are out of sync, typecheck is red, or the"
  echo " mutation lint found more absence assertions without a positive"
  echo " control than the baseline allows."
  echo ""
  echo " Run 'npm run verify:fast' to see which (or 'npm run verify' for"
  echo " the full suite too)."
  echo " Deliberate and justified? 'git commit --no-verify'."
  echo "──────────────────────────────────────────────────────────────"
  exit 1
fi

# The tiles are generated. A commit where they disagree with lib/train is
# one where the shipped app and the engine have quietly diverged.
if ! git diff --quiet -- public/tiles/train.html tiles-library/train.html; then
  echo ""
  echo " COMMIT BLOCKED — build:tiles changed the tiles and they are not staged."
  echo " Run 'git add public/tiles/train.html tiles-library/train.html'."
  exit 1
fi

echo "pre-commit: clean"
